---
// src/components/HeroSection.astro
---
<section 
  data-hero 
  class="relative left-1/2 w-screen -translate-x-1/2 min-h-[90svh] flex items-center justify-center overflow-hidden"
>
  <!-- Full-bleed hero image -->
  <img 
    src="/images/hold-the-rose-flower.webp" 
    alt="Artist Hero" 
    class="absolute inset-0 w-full h-full object-cover object-top"
  />

  <div class="relative z-10 flex flex-col justify-between items-center text-center px-4 w-full max-w-4xl h-full py-12">
    <!-- Top: Heading -->
    <div class="w-full">
      <a data-hero-heading href="#music" class="text-[#204317] hover:text-[#e60026] hover:scale-105 font-bold font-serif uppercase tracking-[0.3em] text-3xl md:text-6xl leading-tight transition-all duration-700 ease-out opacity-0 -translate-y-6 block will-change-transform">
        Hold The Rose
      </a>
    </div>

    <!-- Bottom: CTA -->
    <div class="w-full flex justify-center">
      <a data-hero-cta href="#music" class="mt-auto px-8 py-4 bg-[#204317] text-[#faf8f5] font-bold font-serif uppercase tracking-widest text-sm hover:bg-[#e60026] hover:scale-105 transition-all duration-300 opacity-0 translate-y-6 ease-out will-change-transform">
        Coming Soon
      </a>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const hero = document.querySelector<HTMLElement>('[data-hero]');
      if (!hero) return;

      // Lock height strictly on initial load so address bar collapsing never causes jumpiness
      if (window.innerWidth < 768) {
        hero.style.height = `${window.innerHeight * 0.95}px`;
      }

      const heading = hero.querySelector('[data-hero-heading]');
      const cta = hero.querySelector('[data-hero-cta]');

      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            heading?.classList.remove('opacity-0', '-translate-y-6');
            heading?.classList.add('opacity-100', 'translate-y-0');
            cta?.classList.remove('opacity-0', 'translate-y-6');
            cta?.classList.add('opacity-100', 'translate-y-0');
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2 });

      observer.observe(hero);
    });
  </script>
</section>