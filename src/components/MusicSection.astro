---
// src/components/MusicSection.astro
import { getCollection, type CollectionEntry } from 'astro:content';

// 1. Fetch all music releases
const unsortedEntries = await getCollection('releases');

// 2. Sort them numerically based on the 'order' field with explicit TypeScript types
const musicEntries = unsortedEntries.sort(
  (a: CollectionEntry<'releases'>, b: CollectionEntry<'releases'>) => a.data.order - b.data.order
);
---

<div id="music-container" class="w-full relative opacity-0 translate-x-16 transition-all duration-2000 ease-out">
  
  <div class="flex items-end justify-between mb-8">
    <h2 class="text-[#faf8f5] text-3xl md:text-5xl font-bold font-serif tracking-tighter uppercase">Music</h2>
    <p class="text-[#faf8f5] text-sm tracking-widest font-serif uppercase hidden md:block">Listen Now</p>
  </div>

  <!-- OUTER WRAPPER: Handles the padding and holds the arrows -->
  <div class="relative w-full carousel-wrapper md:px-14 py-4">
    
    <!-- INNER WRAPPER: Strictly cuts off the third card before it hits the padding -->
    <div class="w-full overflow-hidden">
      
      <div id="music-track" class="flex gap-6 cursor-grab active:cursor-grabbing">
        
        {musicEntries.reverse().map((entry: CollectionEntry<'releases'>) => (
          
          <div class="shrink-0 w-full md:w-[calc(50%-12px)] flex flex-col music-card">
            
            {/* IMAGE CONTAINER */}
            <div class="group overflow-hidden bg-[#9b1c31] group-hover:border-[#9b1c31] transition-colors duration-500 relative mb-4">
              <img 
                src={entry.data.coverArt} 
                alt={`Cover art for ${entry.data.title}`} 
                class="w-full aspect-square object-cover group-hover:scale-[0.98] transition-transform duration-500 ease-out" 
              />
            </div>

            {/* TITLE & LISTEN NOW ROW */}
            <div class="flex justify-between items-center px-1">
              <h3 class="text-3xl md:text-4xl font-serif text-[#faf8f5] uppercase tracking-tight truncate transition-colors duration-300">
                {entry.data.title}
              </h3>
              
              {/* UPDATE: This now routes to your custom smart link page */}
              <a 
                href={`/listen/${entry.data.slug || entry.id}`}
                target="_blank" rel="noopener noreferrer"
                class="text-sm text-[#faf8f5] hover:text-[#db1644] uppercase tracking-widest underline decoration-1 underline-offset-4 transition-colors duration-300 whitespace-nowrap ml-4 cursor-pointer"
              >
                Get It Now
              </a>
            </div>

          </div>
        ))}
        
      </div>
    </div>

    <!-- Navigation Arrows -->
    <button id="prev-music" class="absolute left-2 md:-left-4 top-[45%] -translate-y-1/2 bg-transparent text-[#faf8f5] hover:text-[#db1644] hover:scale-150 transition-all duration-300 text-3xl opacity-100 md:opacity-0 z-10 border-none outline-none flex items-center justify-center cursor-pointer p-2">
      &larr;
    </button>
    <button id="next-music" class="absolute right-2 md:-right-4 top-[45%] -translate-y-1/2 bg-transparent text-[#faf8f5] hover:text-[#db1644] hover:scale-150 transition-all duration-300 text-3xl opacity-100 md:opacity-0 z-10 border-none outline-none flex items-center justify-center cursor-pointer p-2">
      &rarr;
    </button>
  </div>
</div>

<style>
  .carousel-wrapper:hover #prev-music,
  .carousel-wrapper:hover #next-music {
    opacity: 1;
  }

  /* NEW: Top-to-Bottom Reveal Classes */
  .reveal-hidden {
    opacity: 0;
    clip-path: inset(0 0 100% 0);
  }
  
  .reveal-visible {
    opacity: 1;
    clip-path: inset(0 0 0 0);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    
    // --- NEW SCROLL ANIMATION LOGIC ---
    const musicContainer = document.getElementById('music-container');
    
    if (musicContainer) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          // When the section enters the screen
          if (entry.isIntersecting) {
            // Remove the offset and invisible classes
            musicContainer.classList.remove('opacity-0', 'translate-x-16');
            // Add full opacity and snap to original position (0)
            musicContainer.classList.add('opacity-100', 'translate-x-0');
            
            // Stop observing so it doesn't animate every time you scroll up and down
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 }); // Triggers when 15% of the section is visible

      observer.observe(musicContainer);
    }
    // -----------------------------------

    const track = document.getElementById('music-track') as HTMLElement;
    const nextBtn = document.getElementById('next-music') as HTMLButtonElement;
    const prevBtn = document.getElementById('prev-music') as HTMLButtonElement;
    
    let isAnimating = false;

    const getSlideDistance = () => {
      const firstCard = track.firstElementChild as HTMLElement;
      return firstCard.offsetWidth + 24; 
    };

    const nextSlide = () => {
      if (isAnimating || !track.firstElementChild) return;
      isAnimating = true;

      const slideDistance = getSlideDistance();

      track.style.transition = 'transform 500ms ease-in-out';
      track.style.transform = `translateX(-${slideDistance}px)`;

      setTimeout(() => {
        track.style.transition = 'none';
        track.appendChild(track.firstElementChild as HTMLElement);
        track.style.transform = 'translateX(0)';
        isAnimating = false;
      }, 500);
    };

    const prevSlide = () => {
      if (isAnimating || !track.lastElementChild) return;
      isAnimating = true;

      const slideDistance = getSlideDistance();

      track.style.transition = 'none';
      track.insertBefore(track.lastElementChild as HTMLElement, track.firstElementChild);
      
      track.style.transform = `translateX(-${slideDistance}px)`;

      void track.offsetWidth;

      track.style.transition = 'transform 500ms ease-in-out';
      track.style.transform = 'translateX(0)';

      setTimeout(() => {
        isAnimating = false;
      }, 500);
    };

    if(nextBtn) nextBtn.addEventListener('click', nextSlide);
    if(prevBtn) prevBtn.addEventListener('click', prevSlide);

    let startX = 0;
    
    track.addEventListener('touchstart', (e) => {
      startX = e.changedTouches[0].screenX;
    });

    track.addEventListener('touchend', (e) => {
      let endX = e.changedTouches[0].screenX;
      if (endX < startX - 50) nextSlide(); 
      if (endX > startX + 50) prevSlide(); 
    });
  });
</script>