---
// src/components/MusicSection.astro
import { getCollection, type CollectionEntry } from 'astro:content';

// Load all release entries from the content collection.
const unsortedEntries = await getCollection('releases');

// Sort by release order so the carousel shows releases in a predictable sequence.
const musicEntries = unsortedEntries.sort(
  (a: CollectionEntry<'releases'>, b: CollectionEntry<'releases'>) => a.data.order - b.data.order
);
---

<div id="music-container" class="w-full relative opacity-0 translate-x-16 transition-all duration-2000 ease-out">
  
  <div class="flex items-end justify-between mb-8">
    <h2 class="text-[#faf8f5] text-3xl md:text-5xl font-bold font-serif tracking-tighter uppercase">Music</h2>
    <p class="text-[#faf8f5] text-sm tracking-widest font-serif uppercase hidden md:block">Listen Now</p>
  </div>

  <!-- The outer wrapper preserves spacing and hosts the navigation arrows. -->
  <div class="relative w-full carousel-wrapper md:px-14 py-4">
    
    <!-- Masking container -->
    <div class="w-full overflow-hidden select-none">
      
      <!-- Interactive track moving directly with touch -->
      <div 
        id="music-track" 
        class="flex gap-6 cursor-grab active:cursor-grabbing will-change-transform touch-pan-y"
      >
        {musicEntries.reverse().map((entry: CollectionEntry<'releases'>) => (
          <div class="shrink-0 w-[85vw] sm:w-[65vw] md:w-[calc(50%-12px)] flex flex-col music-card select-none">
            
            {/* Album artwork card */}
            <div class="group overflow-hidden bg-[#e60026] group-hover:border-[#e60026] transition-colors duration-500 relative mb-4">
              <img 
                src={entry.data.coverArt} 
                alt={`Cover art for ${entry.data.title}`} 
                class="w-full aspect-square object-cover group-hover:scale-[0.98] transition-transform duration-500 ease-out pointer-events-none select-none" 
                draggable="false"
              />
            </div>

            {/* Title and listen link */}
            <div class="flex justify-between items-center px-1">
              <h3 class="text-2xl md:text-4xl font-serif text-[#faf8f5] uppercase tracking-tight truncate transition-colors duration-300">
                {entry.data.title}
              </h3>
              
              <a 
                href={`/listen/${entry.data.slug || entry.id}`}
                target="_blank" rel="noopener noreferrer"
                class="text-xs md:text-sm text-[#faf8f5] hover:text-[#e60026] uppercase tracking-widest underline decoration-1 underline-offset-4 transition-colors duration-300 whitespace-nowrap ml-4 cursor-pointer"
              >
                Get It Now
              </a>
            </div>

          </div>
        ))}
      </div>
    </div>

    <!-- Navigation arrows -->
    <button id="prev-music" aria-label="Previous Release" class="absolute left-2 md:-left-4 top-[45%] -translate-y-1/2 bg-transparent text-[#faf8f5] hover:text-[#e60026] hover:scale-150 transition-all duration-300 text-3xl opacity-100 md:opacity-0 z-10 border-none outline-none flex items-center justify-center cursor-pointer p-2">
      &larr;
    </button>
    <button id="next-music" aria-label="Next Release" class="absolute right-2 md:-right-4 top-[45%] -translate-y-1/2 bg-transparent text-[#faf8f5] hover:text-[#e60026] hover:scale-150 transition-all duration-300 text-3xl opacity-100 md:opacity-0 z-10 border-none outline-none flex items-center justify-center cursor-pointer p-2">
      &rarr;
    </button>
  </div>
</div>

<style>
  .carousel-wrapper:hover #prev-music,
  .carousel-wrapper:hover #next-music {
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Reveal section on scroll
    const musicContainer = document.getElementById('music-container');
    if (musicContainer) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            musicContainer.classList.remove('opacity-0', 'translate-x-16');
            musicContainer.classList.add('opacity-100', 'translate-x-0');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      observer.observe(musicContainer);
    }

    const track = document.getElementById('music-track') as HTMLElement;
    const nextBtn = document.getElementById('next-music') as HTMLButtonElement;
    const prevBtn = document.getElementById('prev-music') as HTMLButtonElement;

    if (!track) return;

    let currentTranslate = 0;
    let prevTranslate = 0;
    let isDragging = false;
    let startX = 0;
    let lastX = 0;
    let velocity = 0;
    let lastTime = 0;
    let animationFrameId: number = 0;

    const getCardWidthWithGap = () => {
      const firstCard = track.firstElementChild as HTMLElement;
      return firstCard ? firstCard.offsetWidth + 24 : 300;
    };

    const setPosition = (pos: number) => {
      track.style.transform = `translateX(${pos}px)`;
    };

    // Reorders DOM nodes seamlessly without visible flickering
    const checkCardWrap = () => {
      const cardWidth = getCardWidthWithGap();

      // Scrolled left past one card: move first element to end
      while (currentTranslate <= -cardWidth) {
        if (!track.firstElementChild) break;
        track.appendChild(track.firstElementChild);
        currentTranslate += cardWidth;
        prevTranslate += cardWidth;
      }

      // Scrolled right past one card: move last element to start
      while (currentTranslate > 0) {
        if (!track.lastElementChild) break;
        track.insertBefore(track.lastElementChild, track.firstElementChild);
        currentTranslate -= cardWidth;
        prevTranslate -= cardWidth;
      }

      setPosition(currentTranslate);
    };

    const smoothSettle = (targetTranslate: number, onComplete?: () => void) => {
      track.style.transition = 'transform 380ms cubic-bezier(0.25, 1, 0.5, 1)';
      currentTranslate = targetTranslate;
      prevTranslate = targetTranslate;
      setPosition(currentTranslate);

      const handleEnd = () => {
        track.style.transition = 'none';
        track.removeEventListener('transitionend', handleEnd);
        checkCardWrap();
        if (onComplete) onComplete();
      };

      track.addEventListener('transitionend', handleEnd);
    };

    // Pointer / Touch Start
    const onStart = (clientX: number) => {
      isDragging = true;
      track.style.transition = 'none';
      startX = clientX;
      lastX = clientX;
      lastTime = performance.now();
      velocity = 0;
      cancelAnimationFrame(animationFrameId);
    };

    // Pointer / Touch Move (1:1 direct tracking)
    const onMove = (clientX: number) => {
      if (!isDragging) return;
      const now = performance.now();
      const deltaX = clientX - startX;
      const dt = now - lastTime;

      if (dt > 0) {
        velocity = (clientX - lastX) / dt;
      }

      lastX = clientX;
      lastTime = now;

      currentTranslate = prevTranslate + deltaX;
      checkCardWrap();
    };

    // Pointer / Touch End (Momentum + soft magnetic alignment)
    const onEnd = () => {
      if (!isDragging) return;
      isDragging = false;

      const cardWidth = getCardWidthWithGap();
      
      // Add momentum based on release flick speed
      const momentumDistance = velocity * 120;
      const projectedTranslate = currentTranslate + momentumDistance;
      
      // Determine the nearest card index
      const cardIndex = Math.round(projectedTranslate / cardWidth);
      const snapTarget = cardIndex * cardWidth;

      smoothSettle(snapTarget);
    };

    // Touch Event Listeners
    track.addEventListener('touchstart', (e) => onStart(e.touches[0].clientX), { passive: true });
    window.addEventListener('touchmove', (e) => onMove(e.touches[0].clientX), { passive: true });
    window.addEventListener('touchend', onEnd);
    window.addEventListener('touchcancel', onEnd);

    // Mouse Event Listeners (Desktop drag)
    track.addEventListener('mousedown', (e) => onStart(e.clientX));
    window.addEventListener('mousemove', (e) => {
      if (isDragging) e.preventDefault();
      onMove(e.clientX);
    });
    window.addEventListener('mouseup', onEnd);

    // Button controls
    let isBtnAnimating = false;
    const moveByStep = (direction: 'next' | 'prev') => {
      if (isBtnAnimating || isDragging) return;
      isBtnAnimating = true;

      const cardWidth = getCardWidthWithGap();
      const target = direction === 'next' ? currentTranslate - cardWidth : currentTranslate + cardWidth;

      smoothSettle(target, () => {
        isBtnAnimating = false;
      });
    };

    if (nextBtn) nextBtn.addEventListener('click', () => moveByStep('next'));
    if (prevBtn) prevBtn.addEventListener('click', () => moveByStep('prev'));
  });
</script>