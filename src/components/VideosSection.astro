---
// src/components/VideosSection.astro
import videos from '../data/videos.json';

interface VideoData {
  id: string;
  title: string;
  type: string;
  thumbnail: string;
  youtubeId: string;
}
---

<!-- Videos carousel with inline YouTube playback modal. -->
<div id="videos-container" class="w-full opacity-0 -translate-x-16 transition-all duration-2000 ease-out">
  
  <div class="flex items-end justify-between mb-8">
    <h2 class="text-3xl md:text-5xl font-bold font-serif tracking-tighter uppercase">Videos</h2>
    <p class="text-[#204317] text-sm font-serif tracking-widest uppercase hidden md:block">Watch & Listen</p>
  </div>

  <div class="relative w-full max-w-4xl mx-auto overflow-hidden group">
    
    <div id="video-track" class="flex cursor-grab active:cursor-grabbing">
      
      {([...videos].reverse() as VideoData[]).map((video) => (
        
        <div class="w-full shrink-0 flex flex-col">
          
          <div class="w-full relative aspect-video overflow-hidden border border-zinc-900" data-youtube-id={video.youtubeId}>
            
            <img 
              src={video.thumbnail} 
              alt={video.title} 
              class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
            />
            
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
              <button class="play-btn pointer-events-auto text-[#faf8f5]/90 hover:text-[#e60026] hover:scale-125 transition-all duration-300 drop-shadow-2xl flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-24 h-24 md:w-32 md:h-32">
                  <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd" />
                </svg>
              </button>
            </div>

          </div>

          <div class="w-full p-6 pt-5">
            <h3 class="text-[#204317] text-3xl md:text-4xl font-serif uppercase tracking-tight">{video.title}</h3>
          </div>

        </div>
      ))}
    </div>

    <button id="prev-video" class="absolute left-2 md:left-4 top-[45%] -translate-y-1/2 bg-transparent text-[#faf8f5] hover:text-[#e60026] hover:scale-150 transition-all duration-300 text-3xl opacity-100 z-10 border-none outline-none flex items-center justify-center cursor-pointer p-2 drop-shadow-md">
      &larr;
    </button>
    <button id="next-video" class="absolute right-2 md:right-4 top-[45%] -translate-y-1/2 bg-transparent text-[#faf8f5] hover:text-[#e60026] hover:scale-150 transition-all duration-300 text-3xl opacity-100 z-10 border-none outline-none flex items-center justify-center cursor-pointer p-2 drop-shadow-md">
      &rarr;
    </button>
  </div>

</div>

<div id="youtube-modal" class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-lg hidden flex-col items-center justify-center p-4 md:p-12 opacity-0 transition-opacity duration-300">
  
  <button id="close-modal" class="absolute top-6 right-6 text-white hover:text-[#e60026] tracking-widest uppercase text-sm font-bold transition-colors">
    Close [X]
  </button>
  
  <div class="w-full max-w-6xl aspect-video bg-black overflow-hidden border border-zinc-800 shadow-2xl">
    <iframe id="youtube-iframe" class="w-full h-full" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Reveal the section once it enters the viewport.
    const videosContainer = document.getElementById('videos-container');
    
    if (videosContainer) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // Remove the offset (-translate-x-16) and invisible classes
            videosContainer.classList.remove('opacity-0', '-translate-x-16');
            videosContainer.classList.add('opacity-100', 'translate-x-0');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      observer.observe(videosContainer);
    }

    const track = document.getElementById('video-track') as HTMLElement;
    const nextBtn = document.getElementById('next-video') as HTMLButtonElement;
    const prevBtn = document.getElementById('prev-video') as HTMLButtonElement;
    const modal = document.getElementById('youtube-modal') as HTMLElement;
    const iframe = document.getElementById('youtube-iframe') as HTMLIFrameElement; 
    const closeModalBtn = document.getElementById('close-modal') as HTMLButtonElement;

    let isAnimating = false;

    const nextSlide = () => {
      if (isAnimating) return; 
      isAnimating = true;

      track.style.transition = 'transform 500ms ease-in-out';
      track.style.transform = 'translateX(-100%)';

      setTimeout(() => {
        track.style.transition = 'none';
        track.appendChild(track.firstElementChild as HTMLElement);
        track.style.transform = 'translateX(0)';
        isAnimating = false;
      }, 500);
    };

    const prevSlide = () => {
      if (isAnimating) return;
      isAnimating = true;

      track.style.transition = 'none';
      track.insertBefore(track.lastElementChild as HTMLElement, track.firstElementChild);
      track.style.transform = 'translateX(-100%)';
      void track.offsetWidth;
      track.style.transition = 'transform 500ms ease-in-out';
      track.style.transform = 'translateX(0)';

      setTimeout(() => {
        isAnimating = false;
      }, 500);
    };

    nextBtn.addEventListener('click', nextSlide);
    prevBtn.addEventListener('click', prevSlide);

    let startX = 0;
    
    track.addEventListener('touchstart', (e) => {
      startX = e.changedTouches[0].screenX;
    });

    track.addEventListener('touchend', (e) => {
      let endX = e.changedTouches[0].screenX;
      if (endX < startX - 50) nextSlide(); 
      if (endX > startX + 50) prevSlide(); 
    });

    // Clicking a play button swaps the modal iframe source to the selected YouTube video.
    document.querySelectorAll('.play-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slide = btn.closest('[data-youtube-id]');
        const youtubeId = slide?.getAttribute('data-youtube-id');
        
        if (youtubeId) {
          iframe.src = `https://www.youtube.com/embed/${youtubeId}?autoplay=1`;
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          setTimeout(() => modal.classList.remove('opacity-0'), 10); 
        }
      });
    });

    const closeModal = () => {
      modal.classList.add('opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        iframe.src = ''; 
      }, 300);
    };

    closeModalBtn.addEventListener('click', closeModal);
    
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  });
</script>