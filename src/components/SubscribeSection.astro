---
// src/components/SubscribeSection.astro
---

<div class="w-full max-w-4xl mx-auto">
  <div class="border border-[#e2ebd3] rounded-2xl p-8 md:p-16 flex flex-col items-center text-center">
    
    <h2 class="text-3xl md:text-5xl font-bold tracking-tighter uppercase mb-4 text-[#faf8f5]">
      SUBSCRIBE
    </h2>
    
    <p class="text-[#faf8f5] font-medium tracking-widest uppercase text-xs md:text-sm mb-10 max-w-lg">
      Sign up for the newsletter to get exclusive unreleased demos, behind-the-scenes visuals, and private show announcements.
    </p>

    <!-- MailerLite Form Embed Area -->
    <div class="w-full max-w-md">
      
      <!-- MailerLite Form Anchor -->
      <div class="ml-embedded" data-form="3A9cxX"></div>

    </div>

    <p class="text-[#faf8f5] text-xs mt-6 uppercase tracking-widest">
      No spam. Unsubscribe at any time.
    </p>

  </div>
</div>