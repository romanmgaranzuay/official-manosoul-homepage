---
// src/components/EventsSection.astro
---

<!-- Events widget with a simple reveal animation. -->
<div id="events-container" class="w-full opacity-0 -translate-x-16 transition-all duration-2000 ease-out">
  
  <div class="flex items-end justify-between mb-8">
    <h2 class="text-3xl md:text-5xl font-bold font-serif tracking-tighter uppercase">Events</h2>
    <p class="text-[#2d5f43] text-sm tracking-widest font-serif uppercase hidden md:block">Live & Direct</p>
  </div>

  <div class="border border-[#e2ebd3] rounded-2xl p-4 md:p-8 bg-[#faf8f5]">
    
    <script is:inline charset="utf-8" src="https://widget.bandsintown.com/main.min.js"></script>
    
    <a 
      class="bit-widget-initializer"
      data-artist-name="id_15659409"
      data-background-color="#faf8f5"
      data-font="sans-serif"
      data-text-color="#2d5f43"
      data-link-color="#1b3a2a"
      data-button-text-color="#faf8f5"
      data-button-background-color="#9b1c31"
      data-separator-color="#e2ebd3"
      data-display-local-dates="false"
      data-display-past-dates="false"
      data-auto-style="true"
      href="https://www.bandsintown.com/a/15659409-manosoul"
    >
      <div class="text-center text-[#2d5f43] py-10">Loading events...</div>
    </a>

  </div>
</div>

<!-- Scroll reveal for the events widget. -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const eventsContainer = document.getElementById('events-container');
    
    if (eventsContainer) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            eventsContainer.classList.remove('opacity-0', '-translate-x-16');
            eventsContainer.classList.add('opacity-100', 'translate-x-0');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      observer.observe(eventsContainer);
    }
  });
</script>