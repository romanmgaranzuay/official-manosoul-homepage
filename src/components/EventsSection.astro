---
// src/components/EventsSection.astro
---

<div class="w-full">
  
  <!-- Section Header -->
  <div class="flex items-end justify-between mb-8">
    <h2 class="text-3xl md:text-5xl font-bold tracking-tighter uppercase">Events</h2>
    <p class="text-[#2d5f43] text-sm tracking-widest uppercase hidden md:block">Live & Direct</p>
  </div>

  <!-- Widget Container (Removed overflow-hidden) -->
  <div class="border border-[#e2ebd3] rounded-2xl p-4 md:p-8 bg-[#faf8f5]">
    
    <script is:inline charset="utf-8" src="https://widget.bandsintown.com/main.min.js"></script>
    
    <a 
      class="bit-widget-initializer"
      data-artist-name="id_15659409"
      data-background-color="#faf8f5"
      data-font="sans-serif"
      data-text-color="#2d5f43"
      data-link-color="#1b3a2a"
      data-button-text-color="#faf8f5"
      data-button-background-color="#9b1c31"
      data-separator-color="#e2ebd3"
      data-display-local-dates="false"
      data-display-past-dates="false"
      data-auto-style="true"
      href="https://www.bandsintown.com/a/15659409-manosoul"
    >
      <div class="text-center text-[#2d5f43] py-10">Loading events...</div>
    </a>

  </div>
</div>