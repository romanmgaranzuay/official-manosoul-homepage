---
// src/layouts/BaseLayout.astro
import '../styles/global.css'; 
import Navbar from '../components/Navbar.astro';

const { title = "My Artist Website", fullWidth = false } = Astro.props;
---

<!-- Add scroll-smooth right here -->
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- Google tag (gtag.js) -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-J2WQN5Q5E2"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'G-J2WQN5Q5E2', {
                debug_mode: true
            });
        </script>

        <!-- Meta Pixel Code -->
        <script is:inline>
            !function(f,b,e,v,n,t,s)
            {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};
            if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
            n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t,s)}(window, document,'script',
            'https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', '978519845242201');
            fbq('track', 'PageView');
        </script>

        <noscript>
        <img 
            height="1" 
            width="1" 
            style="display:none"
            src="https://www.facebook.com/tr?id=978519845242201&ev=PageView&noscript=1"
        />
        </noscript>

        <title>{title}</title>
        <!-- Google Fonts: Cormorant Garamond (serif), Plus Jakarta Sans (sans), Space Grotesk (mono) -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <!-- MailerLite Universal -->
        <script is:inline>
            (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[])
            .push(arguments);},l=d.createElement(e),l.async=1,l.src=u,
            n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
            (window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
            ml('account', '1429872');
        </script>
        <!-- End MailerLite Universal -->
    </head>
    <body class="bg-[#faf8f5] text-[#1b3a2a] font-sans min-h-screen flex flex-col selection:bg-[#1b3a2a] selection:text-[#faf8f5] relative overflow-x-hidden">
    
    {/* 1. Canvas Texture Overlay (Fixed quote syntax inside style) */}
    <div 
        class="fixed inset-0 pointer-events-none z-50 opacity-[0.035] mix-blend-overlay"
        style="background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 200 200\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noiseFilter\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.8\' numOctaves=\'3\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23noiseFilter)\'/%3E%3C/svg%3E');"
    ></div>

    {/* 3. Page Content Stack */}
    <div class="relative z-10 flex flex-col min-h-screen w-full">
        <Navbar />

        <main class="flex-grow w-full max-w-7xl mx-auto px-6">
            <slot />
        </main>

        <footer class="py-4 border-t bg-[#faf8f5] border-[#e2ebd3] mt-auto text-center text-[#0f1d15] font-mono text-xs tracking-widest uppercase">
            <p>&copy; {new Date().getFullYear()} Manosoul. All rights reserved.</p>
        </footer>
    </div>

    </body>
</html>