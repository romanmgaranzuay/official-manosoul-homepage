---
// src/layouts/BaseLayout.astro
import '../styles/global.css'; 
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  fullWidth?: boolean;
}

const { 
  title = "Manosoul | Official Website", 
  description = "Official homepage of Manosoul. Check out the latest music and events.",
  image = "/images/hold-the-rose-flower-card-img.jpg", // Create or point to a default share image in public/
  ogType = "website"
} = Astro.props;

// Resolve canonical and share-image URLs from the current page so metadata stays correct everywhere.
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://manosoul.com');
const fullImageUrl = new URL(image, Astro.site || 'https://manosoul.com').href;
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <meta name="color-scheme" content="light" />
        <meta name="supported-color-schemes" content="light" />

        <!-- Primary SEO and social sharing metadata for every page -->
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL.href} />
        <meta name="theme-color" content="#ffffff" />

        <!-- Icons & Web App Manifest -->
        <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />

        <!-- Open Graph / Facebook -->
        <meta property="og:site_name" content="Manosoul" />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={fullImageUrl} />
        <meta property="og:image:alt" content="Manosoul Official Banner" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content="en_US" />

        <!-- Twitter / X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@manosoul0" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={fullImageUrl} />

        <!-- Structured Data (JSON-LD for Music Group / Artist) -->
        <script is:inline type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "MusicGroup",
          "name": "Manosoul",
          "url": "https://manosoul.com",
          "image": fullImageUrl,
          "sameAs": [
            "https://www.instagram.com/manosoul0/",
            "https://www.tiktok.com/@manosoul0",
            "https://x.com/manosoul0"
          ]
        })} />

        <!-- Google Fonts: Cormorant Garamond, Plus Jakarta Sans, Space Grotesk -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">

        <!-- Google Analytics (GA4) -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-J2WQN5Q5E2"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'G-J2WQN5Q5E2', {
                debug_mode: true
            });
        </script>

        <!-- Meta Pixel Code -->
        <script is:inline>
            !function(f,b,e,v,n,t,s)
            {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};
            if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
            n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t,s)}(window, document,'script',
            'https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', '978519845242201');
            fbq('track', 'PageView');
        </script>

        <noscript>
          <img 
              height="1" 
              width="1" 
              style="display:none"
              src="https://www.facebook.com/tr?id=978519845242201&ev=PageView&noscript=1"
          />
        </noscript>

        <!-- MailerLite Universal -->
        <script is:inline>
            (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[])
            .push(arguments);},l=d.createElement(e),l.async=1,l.src=u,
            n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
            (window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
            ml('account', '1429872');
        </script>
    </head>
    <body class="bg-[#faf8f5] text-[#204317] font-sans min-h-screen flex flex-col selection:bg-[#204317] selection:text-[#faf8f5] relative overflow-x-hidden" style="background-color: #faf8f5 !important; color: #204317 !important;">
    
    <!-- Subtle texture overlay keeps large open areas from feeling flat. -->
    <div 
        class="fixed inset-0 pointer-events-none z-50 opacity-[0.035] mix-blend-overlay"
        style="background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 200 200\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noiseFilter\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.8\' numOctaves=\'3\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23noiseFilter)\'/%3E%3C/svg%3E');"
    ></div>

    <!-- Page shell: navbar, centered content, and footer. Individual sections can still opt into full-bleed layouts. -->
    <div class="relative z-10 flex flex-col min-h-screen w-full">
        <Navbar />

        <main class="flex-grow w-full max-w-7xl mx-auto px-6">
            <slot />
        </main>

        <footer class="py-4 border-t bg-[#faf8f5] border-[#e2ebd3] mt-auto text-center text-[#204317] font-mono text-xs tracking-widest uppercase">
            <p>&copy; {new Date().getFullYear()} Manosoul. All rights reserved.</p>
        </footer>
    </div>

    </body>
</html>