---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import MusicSection from '../components/MusicSection.astro';
import VideosSection from '../components/VideosSection.astro';
import ShopSection from '../components/ShopSection.astro';
import EventsSection from '../components/EventsSection.astro';
import SubscribeSection from '../components/SubscribeSection.astro';
---

<BaseLayout 
  title="Manosoul | Official Website" 
  description="Official homepage of Manosoul. Check out the latest music and events."
  image="/images/hold-the-rose-flower-card-img.jpg"
>

  <section id="home" class="min-h-[80vh]">
      <HeroSection />
  </section>

    <!-- These sections intentionally break out of the centered layout and span the viewport. -->
    <!-- <section id="shop" class="py-24 border-t border-[#204317] bg-[#204317] relative left-1/2 w-screen -translate-x-1/2">
      <div class="max-w-7xl mx-auto px-6 w-full">
          <ShopSection />
      </div>
  </section>

  <section id="videos" class="py-24 border-t border-[#e2ebd3]">
      <VideosSection />
  </section> -->

  <section id="music" class="py-24 border-t border-[#204317] bg-[#204317] relative left-1/2 w-screen -translate-x-1/2">
      <div class="max-w-7xl mx-auto px-6 w-full">
          <MusicSection />
      </div>
  </section>

  <section id="events" class="py-24 border-t border-[#204317]">
      <EventsSection />
  </section>

  <section id="subscribe" class="py-24 border-t border-[#204317] bg-[#204317] relative left-1/2 w-screen -translate-x-1/2">
      <div class="max-w-7xl mx-auto px-6 w-full">
          <SubscribeSection />
      </div>
  </section>

</BaseLayout>