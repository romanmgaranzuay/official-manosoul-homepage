---
// src/pages/listen/[slug].astro
import { getCollection, type CollectionEntry } from 'astro:content';
import '../../styles/global.css';

// Import all SVG icons
import spotifyIcon from '../../assets/icons/spotify.svg';
import appleIcon from '../../assets/icons/apple-music.svg';
import youtubeIcon from '../../assets/icons/youtube.svg';
import youtubeMusicIcon from '../../assets/icons/youtube-music.svg';
import amazonIcon from '../../assets/icons/amazon-music.svg';
import bandcampIcon from '../../assets/icons/bandcamp.svg';
import soundcloudIcon from '../../assets/icons/soundcloud.svg';

export async function getStaticPaths() {
  const releaseEntries = await getCollection('releases');
  return releaseEntries.map((entry: CollectionEntry<'releases'>) => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'releases'>;
}

const { entry } = Astro.props;
const { 
  title, 
  coverArt,
  isPreSave,
  presaveUrl, 
  spotifyUrl, 
  appleMusicUrl, 
  youtubeUrl, 
  youtubeMusicUrl, 
  amazonMusicUrl, 
  bandcampUrl, 
  soundcloudUrl 
} = entry.data;

const optimizedCover = { src: coverArt };

// Dynamically resolve canonical & absolute asset URLs using Astro.url and Astro.site
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://manosoul.com');
const fullCoverUrl = new URL(coverArt, Astro.site || 'https://manosoul.com').href;
---

<html lang="en">
  <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manosoul - {title}</title>
  
  <!-- Primary SEO -->
  <meta name="description" content={`Listen to "${title}" by Manosoul on Spotify, Apple Music, YouTube, and more.`} />
  <link rel="canonical" href={canonicalURL.href} />
  <meta name="theme-color" content="#ffffff" />

  <!-- Icons & Web App Manifest -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Open Graph / Facebook -->
  <meta property="og:site_name" content="Manosoul" />
  <meta property="og:type" content="music.song" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:title" content={`Manosoul - ${title}`} />
  <meta property="og:description" content={`Listen to "${title}" by Manosoul on Spotify, Apple Music, YouTube, and more.`} />
  <meta property="og:image" content={fullCoverUrl} />
  <meta property="og:image:alt" content={`Album cover art for ${title} by Manosoul`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="1200" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@manosoul0" />
  <meta name="twitter:title" content={`Manosoul - ${title}`} />
  <meta name="twitter:description" content={`Listen to "${title}" by Manosoul on streaming services.`} />
  <meta name="twitter:image" content={fullCoverUrl} />

  <!-- Structured Data (JSON-LD for Music Recording) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MusicRecording",
    "name": title,
    "url": canonicalURL.href,
    "image": fullCoverUrl,
    "byArtist": {
      "@type": "MusicGroup",
      "name": "Manosoul",
      "url": "https://manosoul.com"
    },
    "inAlbum": {
      "@type": "MusicAlbum",
      "name": title
    }
  })} />

  <!-- Google Analytics (GA4) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-J2WQN5Q5E2"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-J2WQN5Q5E2', { debug_mode: true });
  </script>

  <!-- Meta Pixel Code -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '978519845242201');
    fbq('track', 'PageView');
  </script>

  <noscript>
    <img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=978519845242201&ev=PageView&noscript=1" />
  </noscript>
</head>

  <body class="relative min-h-screen w-full flex flex-col items-center justify-start p-6 pt-8 md:pt-12 pb-16 font-sans overflow-y-auto">
    
    <!-- Background Cover Art -->
    <div 
      class="fixed inset-0 w-full h-full bg-cover bg-center bg-no-repeat -z-20 blur-3xl scale-110 pointer-events-none"
      style={`background-image: url('${optimizedCover.src}');`}
    ></div>

    <!-- White Overlay -->
    <div class="fixed inset-0 w-full h-full bg-white/30 -z-10 pointer-events-none"></div>

    <!-- Foreground Content Card -->
    <main class="w-full max-w-md flex flex-col items-center z-10 my-auto">
      
      <!-- Album Art -->
      <div class="w-1/2 aspect-square mb-6 overflow-hidden shadow-2xl border border-black/10 rounded-lg">
        <img 
          src={optimizedCover.src} 
          alt={`Cover art for ${title}`} 
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Title & Subtitle -->
      <h1 class="text-xl md:text-2xl font-bold tracking-normal text-center text-black/75 mb-1">
        Manosoul - {title}
      </h1>
      <p class="text-xs uppercase tracking-widest font-semibold text-black/75 mb-8 text-center">
        {isPreSave ? 'Pre-Save on Spotify, Apple Music, and more!' : 'Choose Your Music Service'}
      </p>

      <!-- TASK 4: Pre-Save Toggle vs Live Links -->
      {isPreSave && presaveUrl ? (
        <div class="w-full flex flex-col items-center gap-4">
          {/* <p class="text-sm text-black/80 text-center mb-2">
            Be the first to listen. Pre-save on your favorite platform via Feature.fm:
          </p> */}
          <a 
            href={presaveUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            data-presave="true"
            data-platform="Feature.fm Pre-Save"
            data-title={title}
            class="stream-btn w-full h-[72px] px-6 border-2 border-black/75 bg-black text-white flex items-center justify-center font-bold uppercase tracking-widest hover:bg-white hover:text-black transition-colors duration-300"
          >
            Pre-Save Now &rarr;
          </a>
        </div>
      ) : (
        <div class="w-full flex flex-col gap-4">
    
          {spotifyUrl && (
            <a href={spotifyUrl} target="_blank" rel="noopener noreferrer" data-platform="Spotify" data-title={title} class="stream-btn relative w-full h-[72px] px-6 border-2 border-black/75 bg-white/80 backdrop-blur-md flex items-center overflow-hidden transition-colors duration-500 group hover:bg-[#1DB954] hover:border-[#1DB954]">
              <img src={spotifyIcon.src} alt="Spotify" class="w-32 h-12 object-contain object-left transition-all duration-500 ease-out group-hover:-translate-x-[150%] group-hover:opacity-0" />
              <div class="absolute right-6 flex items-center justify-center transition-all duration-500 ease-out group-hover:right-1/2 group-hover:translate-x-1/2">
                <span class="border border-black/50 text-black/80 px-4 py-1.5 text-xs uppercase tracking-widest font-bold transition-all duration-300 ease-out group-hover:opacity-0 group-hover:-translate-x-8">Play</span>
                <span class="absolute text-white text-xl font-bold opacity-0 translate-x-4 transition-all duration-500 ease-out group-hover:opacity-100 group-hover:translate-x-0 group-hover:scale-[2]">&rarr;</span>
              </div>
            </a>
          )}

          {appleMusicUrl && (
            <a href={appleMusicUrl} target="_blank" rel="noopener noreferrer" data-platform="Apple Music" data-title={title} class="stream-btn relative w-full h-[72px] px-6 border-2 border-black/75 bg-white/80 backdrop-blur-md flex items-center overflow-hidden transition-colors duration-500 group hover:bg-[#FA243C] hover:border-[#FA243C]">
              <img src={appleIcon.src} alt="Apple Music" class="w-32 h-8 object-contain object-left transition-all duration-500 ease-out group-hover:-translate-x-[150%] group-hover:opacity-0" />
              <div class="absolute right-6 flex items-center justify-center transition-all duration-500 ease-out group-hover:right-1/2 group-hover:translate-x-1/2">
                <span class="border border-black/50 text-black/80 px-4 py-1.5 text-xs uppercase tracking-widest font-bold transition-all duration-300 ease-out group-hover:opacity-0 group-hover:-translate-x-8">Play</span>
                <span class="absolute text-white text-xl font-bold opacity-0 translate-x-4 transition-all duration-500 ease-out group-hover:opacity-100 group-hover:translate-x-0 group-hover:scale-[2]">&rarr;</span>
              </div>
            </a>
          )}

          {youtubeUrl && (
            <a href={youtubeUrl} target="_blank" rel="noopener noreferrer" data-platform="YouTube" data-title={title} class="stream-btn relative w-full h-[72px] px-6 border-2 border-black/75 bg-white/80 backdrop-blur-md flex items-center overflow-hidden transition-colors duration-500 group hover:bg-[#FF0000] hover:border-[#FF0000]">
              <img src={youtubeIcon.src} alt="YouTube" class="w-32 h-8 object-contain object-left transition-all duration-500 ease-out group-hover:-translate-x-[150%] group-hover:opacity-0" />
              <div class="absolute right-6 flex items-center justify-center transition-all duration-500 ease-out group-hover:right-1/2 group-hover:translate-x-1/2">
                <span class="border border-black/50 text-black/80 px-4 py-1.5 text-xs uppercase tracking-widest font-bold transition-all duration-300 ease-out group-hover:opacity-0 group-hover:-translate-x-8">Play</span>
                <span class="absolute text-white text-xl font-bold opacity-0 translate-x-4 transition-all duration-500 ease-out group-hover:opacity-100 group-hover:translate-x-0 group-hover:scale-[2]">&rarr;</span>
              </div>
            </a>
          )}

          {youtubeMusicUrl && (
            <a href={youtubeMusicUrl} target="_blank" rel="noopener noreferrer" data-platform="YouTube Music" data-title={title} class="stream-btn relative w-full h-[72px] px-6 border-2 border-black/75 bg-white/80 backdrop-blur-md flex items-center overflow-hidden transition-colors duration-500 group hover:bg-[#000000] hover:border-[#000000]">
              <img src={youtubeMusicIcon.src} alt="YouTube Music" class="w-32 h-11 object-contain object-left transition-all duration-500 ease-out group-hover:-translate-x-[150%] group-hover:opacity-0" />
              <div class="absolute right-6 flex items-center justify-center transition-all duration-500 ease-out group-hover:right-1/2 group-hover:translate-x-1/2">
                <span class="border border-black/50 text-black/80 px-4 py-1.5 text-xs uppercase tracking-widest font-bold transition-all duration-300 ease-out group-hover:opacity-0 group-hover:-translate-x-8">Play</span>
                <span class="absolute text-white text-xl font-bold opacity-0 translate-x-4 transition-all duration-500 ease-out group-hover:opacity-100 group-hover:translate-x-0 group-hover:scale-[2]">&rarr;</span>
              </div>
            </a>
          )}

          {amazonMusicUrl && (
            <a href={amazonMusicUrl} target="_blank" rel="noopener noreferrer" data-platform="Amazon Music" data-title={title} class="stream-btn relative w-full h-[72px] px-6 border-2 border-black/75 bg-white/80 backdrop-blur-md flex items-center overflow-hidden transition-colors duration-500 group hover:bg-[#3f1fe7] hover:border-[#3f1fe7]">
              <img src={amazonIcon.src} alt="Amazon Music" class="w-33 h-10 object-contain object-left transition-all duration-500 ease-out group-hover:-translate-x-[150%] group-hover:opacity-0" />
              <div class="absolute right-6 flex items-center justify-center transition-all duration-500 ease-out group-hover:right-1/2 group-hover:translate-x-1/2">
                <span class="border border-black/50 text-black/80 px-4 py-1.5 text-xs uppercase tracking-widest font-bold transition-all duration-300 ease-out group-hover:opacity-0 group-hover:-translate-x-8">Play</span>
                <span class="absolute text-white text-xl font-bold opacity-0 translate-x-4 transition-all duration-500 ease-out group-hover:opacity-100 group-hover:translate-x-0 group-hover:scale-[2]">&rarr;</span>
              </div>
            </a>
          )}

          {bandcampUrl && (
            <a href={bandcampUrl} target="_blank" rel="noopener noreferrer" data-platform="Bandcamp" data-title={title} class="stream-btn relative w-full h-[72px] px-6 border-2 border-black/75 bg-white/70 backdrop-blur-md flex items-center overflow-hidden transition-colors duration-500 group hover:bg-[#629AA9] hover:border-[#629AA9]">
              <img src={bandcampIcon.src} alt="Bandcamp" class="w-33 h-8 object-contain object-left transition-all duration-500 ease-out group-hover:-translate-x-[150%] group-hover:opacity-0" />
              <div class="absolute right-6 flex items-center justify-center transition-all duration-500 ease-out group-hover:right-1/2 group-hover:translate-x-1/2">
                <span class="border border-black/50 text-black/80 px-4 py-1.5 text-xs uppercase tracking-widest font-bold transition-all duration-300 ease-out group-hover:opacity-0 group-hover:-translate-x-8">Play</span>
                <span class="absolute text-white text-xl font-bold opacity-0 translate-x-4 transition-all duration-500 ease-out group-hover:opacity-100 group-hover:translate-x-0 group-hover:scale-[2]">&rarr;</span>
              </div>
            </a>
          )}

          {soundcloudUrl && (
            <a href={soundcloudUrl} target="_blank" rel="noopener noreferrer" data-platform="SoundCloud" data-title={title} class="stream-btn relative w-full h-[72px] px-6 border-2 border-black/75 bg-white/80 backdrop-blur-md flex items-center overflow-hidden transition-colors duration-500 group hover:bg-[#FF5500] hover:border-[#FF5500]">
              <img src={soundcloudIcon.src} alt="SoundCloud" class="w-33 h-8 object-contain object-left transition-all duration-500 ease-out group-hover:-translate-x-[150%] group-hover:opacity-0" />
              <div class="absolute right-6 flex items-center justify-center transition-all duration-500 ease-out group-hover:right-1/2 group-hover:translate-x-1/2">
                <span class="border border-black/50 text-black/80 px-4 py-1.5 text-xs uppercase tracking-widest font-bold transition-all duration-300 ease-out group-hover:opacity-0 group-hover:-translate-x-8">Play</span>
                <span class="absolute text-white text-xl font-bold opacity-0 translate-x-4 transition-all duration-500 ease-out group-hover:opacity-100 group-hover:translate-x-0 group-hover:scale-[2]">&rarr;</span>
              </div>
            </a>
          )}

        </div>
      )}

      <!-- Minimal Social Footer -->
      <div class="w-full flex justify-center gap-6 mt-12 pt-6 border-t border-black/10">
        <a href="https://www.instagram.com/manosoul0/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-6 h-6 text-black/40 hover:text-black transition-colors">
          <svg role="img" viewBox="0 0 24 24" class="w-full h-full fill-current" xmlns="http://www.w3.org/2000/svg"><title>Instagram</title><path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"/></svg>
        </a>

        <a href="https://www.tiktok.com/@manosoul0" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="w-6 h-6 text-black/40 hover:text-black transition-colors">
          <svg role="img" viewBox="0 0 24 24" class="w-full h-full fill-current" xmlns="http://www.w3.org/2000/svg"><title>TikTok</title><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </a> 

        <a href="https://x.com/manosoul0" target="_blank" rel="noopener noreferrer" aria-label="X" class="text-black/40 hover:text-black w-6 h-6 transition-colors duration-300">
           <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      </div>

    </main>

    <!-- TASK 1: Click Listener for Event Tracking -->
    <script>
      declare global {
        interface Window {
          gtag?: (...args: any[]) => void;
          fbq?: (...args: any[]) => void;
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        const buttons = document.querySelectorAll('.stream-btn');

        buttons.forEach(btn => {
          btn.addEventListener('click', (e) => {
            const target = e.currentTarget as HTMLElement;
            const platform = target.getAttribute('data-platform') || 'Unknown';
            const songTitle = target.getAttribute('data-title') || 'Song';
            const isPreSave = target.getAttribute('data-presave') === 'true';

            if (isPreSave) {
              // --- PRE-SAVE EVENT ---
              
              // 1. GA4 Custom Event
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'presave_click', {
                  'platform': platform,
                  'song_title': songTitle
                });
              }

              // 2. Meta Pixel (Standard 'Lead' + Custom 'PreSaveClick')
              if (typeof window.fbq === 'function') {
                window.fbq('track', 'Lead', { content_name: songTitle });
                window.fbq('trackCustom', 'PreSaveClick', {
                  platform: platform,
                  song_title: songTitle
                });
              }

            } else {
              // --- LIVE STREAMING CLICK EVENT ---
              
              // 1. GA4 Custom Event
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'select_music_platform', {
                  'platform': platform,
                  'song_title': songTitle
                });
              }

              // 2. Meta Pixel (Standard 'ViewContent' + Custom 'OutboundStreamClick')
              if (typeof window.fbq === 'function') {
                window.fbq('track', 'ViewContent', { content_name: songTitle });
                window.fbq('trackCustom', 'OutboundStreamClick', {
                  platform: platform,
                  song_title: songTitle
                });
              }
            }
          });
        });
      });
    </script>
  </body>
</html>