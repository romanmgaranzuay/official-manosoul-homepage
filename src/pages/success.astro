---
// src/pages/success.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<!-- NEW: Added fullWidth={true} -->
<BaseLayout title="Payment Successful | Manosoul" fullWidth={true}>
  <main class="min-h-screen w-full bg-[#0f1d15] flex flex-col items-center justify-center p-6">
    <div class="max-w-md w-full bg-[#faf8f5] p-10 text-center shadow-2xl border border-[#e2ebd3]">
      
      <!-- Checkmark Icon -->
      <div class="w-16 h-16 bg-[#2d5f43] rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-[#faf8f5]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>

      <h1 class="text-3xl font-bold font-serif uppercase tracking-tighter text-[#0f1d15] mb-2">Order Confirmed</h1>
      
      <p class="text-sm font-mono text-[#2d5f43] mb-8 leading-relaxed">
        Thank you for your support. A secure, 15-minute download link has been sent to your email.
      </p>

      <a 
        href="/#shop" 
        class="inline-block w-full py-4 text-center bg-[#0f1d15] text-[#faf8f5] font-bold uppercase tracking-wider text-sm hover:bg-[#9b1c31] transition-colors duration-300 border border-[#0f1d15]"
      >
        Return to Shop
      </a>
      
    </div>
  </main>
</BaseLayout>